<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle dependency verification for the privileged ADB chain (ADR-003 / ADR-004 §2).
  libadb-android + spake2-android come from JitPack, which builds from source on demand, so a
  version string alone does not pin the bytes. Every artifact of those two components is pinned by
  SHA-256 here; the hashes match the aars audited/used on-device. Everything else is trusted by
  rule (it comes from Maven Central / Google, whose artifacts are immutable), so this file stays
  small. The negative-lookahead rule MUST keep excluding com.github.MuntashirAkon*.
  On a deliberate libadb/spake2 bump, re-audit (ADR-004 §2) then regenerate these entries
  (`gradlew write-verification-metadata sha256`). Self-test: scripts/test-dependency-verification.sh
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com\.github\.MuntashirAkon).*" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.github.MuntashirAkon" name="libadb-android" version="3.1.1">
         <artifact name="libadb-android-3.1.1.aar">
            <sha256 value="e6fcb495a20a507ca4a125afc9c554e838a84b3a15fbcc29f7deafd0f88bbb58" origin="jitpack.io download, matches audited aar"/>
         </artifact>
         <artifact name="libadb-android-3.1.1.module">
            <sha256 value="0150c3f56caa73ea0c864df46e55db451acf20d3f98b331965159b1dce87837a" origin="jitpack.io download, matches audited aar"/>
         </artifact>
         <artifact name="libadb-android-3.1.1.pom">
            <sha256 value="0a12f1de3973888d5d54292ddb6299aa60c7906ade92c7cdea3a32d41973583d" origin="jitpack.io download, matches audited aar"/>
         </artifact>
      </component>
      <component group="com.github.MuntashirAkon.spake2-java" name="spake2-android" version="2.2.1">
         <artifact name="spake2-android-2.2.1.aar">
            <sha256 value="8798fb6c04b5d53a6307ed9481e9afe563227abd4e8b9e917c8514fa850071bb" origin="jitpack.io download, matches audited aar"/>
         </artifact>
         <artifact name="spake2-android-2.2.1.module">
            <sha256 value="92852fe3332f072c5440a20e0e2f85bf20d83b904bd86ccc4071707c840901d7" origin="jitpack.io download, matches audited aar"/>
         </artifact>
         <artifact name="spake2-android-2.2.1.pom">
            <sha256 value="7b01f048b5bf764542a81f6c8dcd93a9092bc40e0bf81cc1c8193f60c3a97f19" origin="jitpack.io download, matches audited aar"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
