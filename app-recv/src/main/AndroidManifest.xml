<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Importer requests WRITE access to the Tier-0 domains (+ READ for dedup/matching). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- WRITE_CALL_LOG is DEGOOGLE-ONLY (ADR-007 §6.3 #2) — see src/degoogle/AndroidManifest.xml. -->
    <!-- Camera scans the pairing QR (the out-of-band trust anchor). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Set the home/lock wallpaper (PRP-02). SET_WALLPAPER is a NORMAL, install-time permission:
      no runtime prompt, no privilege bridge — the wallpaper path stays entirely Tier 0. Reading
      the sender's own active wallpaper (app-send) needs no permission, so this is recv-only.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!--
      Apply the default ringtone/notification/alarm SELECTIONS (PRP-04). WRITE_SETTINGS is a
      SPECIAL-ACCESS permission (the "Modify system settings" toggle), NOT a privileged one: it is
      declared so the app is ELIGIBLE to request the access via ACTION_MANAGE_WRITE_SETTINGS, then
      the user grants it per-app. setActualDefaultRingtoneUri writes Settings.System under this
      access — Tier 0, no WRITE_SECURE_SETTINGS and no ADB bridge, so the no-escalation CI gate is
      untouched. Declared recv-only (the sender reads these keys with no permission).
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!--
      Assisted reinstall opens each app's store page via ACTION_VIEW — the store performs the
      install, so NO install permission is needed for the inventory path. QUERY_ALL_PACKAGES lets
      the receiver skip apps already present (inventory dedup + APK AC-18 version check, ADR-006 D3).
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      DEGOOGLE-ONLY surfaces moved out of the shared manifest (ADR-007 §6.3 #2): REQUEST_INSTALL_PACKAGES
      (carried-APK install eligibility) and the SMS/MMS permission family + role components now live in
      app-recv/src/degoogle/AndroidManifest.xml, so the Play/"lite" merged manifest declares NONE of them.
      Lite is Tier-0 only: store-page reinstall (no install permission) still works; carried-APK install
      and SMS/MMS/call-log restore are excluded. build.yml asserts their absence in play, presence in degoogle.
    -->

    <!--
      Keep a long transfer alive when the screen sleeps (#85): the data phase (the live item stream)
      runs under a short-lived foreground service holding a PARTIAL_WAKE_LOCK + a WifiLock(HIGH_PERF),
      so GrapheneOS Doze / Wi-Fi power-save can't suspend the app and let the peer read an RST mid-frame,
      or throttle throughput to a crawl (hardware-observed: a 505 MB transfer trickled at ~0.8 MB/s
      backgrounded without the WifiLock). FOREGROUND_SERVICE and the dataSync type are NORMAL
      install-time permissions — no privilege bridge involved. ACCESS_WIFI_STATE (also NORMAL/
      auto-granted) is what WifiManager.WifiLock.acquire() requires — declared so the lock actually
      engages on hardware (WAKE_LOCK below covers its power semantics). POST_NOTIFICATIONS is
      denied-by-default on GrapheneOS; the process-priority + wakelock benefit holds even when the
      ongoing notification doesn't render (declared, never runtime-requested).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Portage">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Tier-1 privilege path is now self-contained (ADR-003): the :adb-bridge module
          pairs with this device's own Wireless Debugging service and performs the one-shot
          WRITE_SECURE_SETTINGS self-grant. No third-party provider, no exported components —
          the bridge speaks only to localhost adbd.
        -->

        <!--
          APK keystone Tier-0 status-receiver (ADR-006 D3/D6): receives the PackageInstaller commit
          reply and, on STATUS_PENDING_USER_ACTION, launches the system install-confirm dialog. The
          session commit targets this receiver EXPLICITLY (a same-app broadcast), so it is exported="false"
          — a manifest receiver is the robust pattern (a runtime receiver can miss the reply when the
          Activity is backgrounded while the system prepares the confirm intent).
        -->
        <receiver
            android:name=".install.ApkInstallResultReceiver"
            android:exported="false" />

        <!--
          Transfer keep-alive foreground service (#85): hosts the item stream's wakelock + foreground
          importance so a screen-off can't reset the streaming socket mid-frame. Not exported, not
          bound — started/stopped only in-process by ForegroundServiceKeepAlive around the transfer.
        -->
        <service
            android:name=".TransferForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Default-SMS-role components (SmsDeliverReceiver / MmsDeliverReceiver / SmsComposeActivity /
             HeadlessSmsSendService) are DEGOOGLE-ONLY — see app-recv/src/degoogle/AndroidManifest.xml
             (ADR-007 §6.3 #2). Absent from the Play/"lite" merged manifest by construction. -->
    </application>
</manifest>
