<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Importer requests WRITE access to the Tier-0 domains (+ READ for dedup/matching). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- Camera scans the pairing QR (the out-of-band trust anchor). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Set the home/lock wallpaper (PRP-02). SET_WALLPAPER is a NORMAL, install-time permission:
      no runtime prompt, no privilege bridge — the wallpaper path stays entirely Tier 0. Reading
      the sender's own active wallpaper (app-send) needs no permission, so this is recv-only.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!--
      Apply the default ringtone/notification/alarm SELECTIONS (PRP-04). WRITE_SETTINGS is a
      SPECIAL-ACCESS permission (the "Modify system settings" toggle), NOT a privileged one: it is
      declared so the app is ELIGIBLE to request the access via ACTION_MANAGE_WRITE_SETTINGS, then
      the user grants it per-app. setActualDefaultRingtoneUri writes Settings.System under this
      access — Tier 0, no WRITE_SECURE_SETTINGS and no ADB bridge, so the no-escalation CI gate is
      untouched. Declared recv-only (the sender reads these keys with no permission).
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!--
      Assisted reinstall opens each app's store page via ACTION_VIEW — the store performs the
      install, so NO install permission is needed for the inventory path. QUERY_ALL_PACKAGES lets
      the receiver skip apps already present (inventory dedup + APK AC-18 version check, ADR-006 D3).
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
      APK keystone Tier-0 fallback (ADR-006 D3/D6): the carried-app install routes through our own
      PackageInstaller MODE_FULL_INSTALL session, whose commit fires the system install-confirm UI.
      REQUEST_INSTALL_PACKAGES makes the app ELIGIBLE to commit such a session — the USER still
      confirms each install in the system dialog (one tap per app); nothing installs silently here.
      The silent (no-confirm) path is the DEFERRED P6 ADB-gate concern and uses NO extra manifest
      permission (it would run shell-uid via :adb-bridge, not REQUEST_INSTALL_PACKAGES).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      SMS restore (DEVILS_ADVOCATE.md Q4): to be ELIGIBLE for the default-SMS role, the app must
      declare the default-SMS permission family AND the four SMS components below. portage holds
      ROLE_SMS only TRANSIENTLY (acquire → write restored messages → relinquish to the prior
      holder, in a finally — see SmsRoleCoordinator; a persistent ledger backstops process death).
      The components are inert; portage is not a messaging app.

      Per-permission rationale (least-privilege intent):
        SEND_SMS, RECEIVE_SMS, RECEIVE_MMS, RECEIVE_WAP_PUSH — the platform's default-SMS-app
          eligibility set; without them portage cannot appear in the role picker.
        READ_SMS — declared for eligibility completeness. portage-recv only WRITES restored rows
          (never reads on this side), so READ_SMS is a hardware VERIFY_FIRST: confirm on a Pixel/GOS
          device whether the role is grantable without it and, if so, DROP it (privacy-minimal).
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />

    <!--
      Keep a long transfer alive when the screen sleeps (#85): the data phase (the live item stream)
      runs under a short-lived foreground service holding a PARTIAL_WAKE_LOCK, so GrapheneOS Doze /
      Wi-Fi power-save can't suspend the app and let the peer read an RST mid-frame. FOREGROUND_SERVICE
      and the dataSync type are NORMAL install-time permissions — no privilege bridge involved.
      POST_NOTIFICATIONS is denied-by-default on GrapheneOS; the process-priority + wakelock benefit
      holds even when the ongoing notification doesn't render (declared, never runtime-requested).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Portage">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Tier-1 privilege path is now self-contained (ADR-003): the :adb-bridge module
          pairs with this device's own Wireless Debugging service and performs the one-shot
          WRITE_SECURE_SETTINGS self-grant. No third-party provider, no exported components —
          the bridge speaks only to localhost adbd.
        -->

        <!--
          APK keystone Tier-0 status-receiver (ADR-006 D3/D6): receives the PackageInstaller commit
          reply and, on STATUS_PENDING_USER_ACTION, launches the system install-confirm dialog. The
          session commit targets this receiver EXPLICITLY (a same-app broadcast), so it is exported="false"
          — a manifest receiver is the robust pattern (a runtime receiver can miss the reply when the
          Activity is backgrounded while the system prepares the confirm intent).
        -->
        <receiver
            android:name=".install.ApkInstallResultReceiver"
            android:exported="false" />

        <!--
          Transfer keep-alive foreground service (#85): hosts the item stream's wakelock + foreground
          importance so a screen-off can't reset the streaming socket mid-frame. Not exported, not
          bound — started/stopped only in-process by ForegroundServiceKeepAlive around the transfer.
        -->
        <service
            android:name=".TransferForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- === Default-SMS-role eligibility (inert; see SmsRoleComponents.kt) === -->

        <!-- Incoming SMS. BROADCAST_SMS restricts the sender to the system. -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Incoming MMS (WAP push). BROADCAST_WAP_PUSH restricts the sender to the system. -->
        <receiver
            android:name=".sms.MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Compose target for sms:/mms: send intents (portage closes immediately). -->
        <activity
            android:name=".sms.SmsComposeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Quick-reply service. SEND_RESPOND_VIA_MESSAGE restricts the caller to the system. -->
        <service
            android:name=".sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
    </application>
</manifest>
