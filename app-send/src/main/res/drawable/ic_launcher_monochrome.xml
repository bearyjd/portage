<?xml version="1.0" encoding="utf-8"?>
<!--
  portage-send — adaptive icon monochrome layer (v3)
  Single bold canoe in #FFFFFF. System tints it.
  All shapes must be filled (no stroke-only paths in mono layer).

  Cavity rendered as a slightly-alpha white fill so the system-tinted color
  reads lighter inside — or filled with a fixed dark if the renderer supports it.
  Thwarts: filled thin rectangles (parallelograms at the slight tilt).
  Motion ticks: filled parallelograms outside the rotation group.
  Rotation: -8° group matching foreground.

  Copyright (C) 2026 Grepon Labs LLC. Licensed under AGPL-3.0.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rotated group: -8° matching send foreground -->
    <group
        android:pivotX="54"
        android:pivotY="52"
        android:rotation="-8">

        <!-- OUTER HULL — full white -->
        <path
            android:pathData="M18,42
                C20,58 38,74 54,74
                C70,74 88,58 90,42
                C86,28 68,30 54,30
                C40,30 22,28 18,42 Z"
            android:fillColor="#FFFFFF" />

        <!--
          INNER CAVITY — semi-transparent white overlay creates a lighter interior
          that the system tint will differentiate. fillAlpha=0 would be fully punched
          but may not composite correctly; use a very low alpha so cavity reads.
          The outer hull silhouette is what matters at small size anyway.
        -->
        <path
            android:pathData="M25,43
                C27,57 41,67 54,67
                C67,67 81,57 83,43
                C80,32 66,34 54,34
                C42,34 28,32 25,43 Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.25" />

        <!-- THWART 1 — filled rect approximating the 3.2px stroke -->
        <path
            android:pathData="M35.4,39 L38.6,39 L40.6,64 L37.4,64 Z"
            android:fillColor="#FFFFFF" />

        <!-- THWART 2 -->
        <path
            android:pathData="M67.4,39 L70.6,39 L72.6,64 L69.4,64 Z"
            android:fillColor="#FFFFFF" />

    </group>

    <!-- MOTION TICK 1 — filled parallelogram, screen space -->
    <path
        android:pathData="M11,53 L14,50 L22,57 L19,60 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.80" />

    <!-- MOTION TICK 2 — smaller, more faded -->
    <path
        android:pathData="M8,61 L11,58 L19,65 L16,68 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.42" />

</vector>
