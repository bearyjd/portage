<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exporter requests READ-only access to the Tier-0 domains. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- App-inventory enumeration. Confirm GOS policy at runtime (VERIFY_FIRST). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
      Paired-Bluetooth roster read (PRP-07 public-API approach). BLUETOOTH_CONNECT is a NORMAL
      runtime permission (dangerous class), NOT a privilege escalation: it gates the PUBLIC
      BluetoothAdapter.getBondedDevices() API only. It is deliberately distinct from
      WRITE_SECURE_SETTINGS / the ADB bridge that the CI no-escalation gate forbids in the sender,
      and merges into this binary alone. Phase 1 reads the LIST; the receiver shows a re-pair
      checklist. maxSdkVersion is intentionally omitted — BLUETOOTH_CONNECT is the API-31+ runtime
      permission and minSdk is 31. VERIFY_FIRST: getBondedDevices + the grant flow on GOS hardware.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Least-privilege: the sender NEVER escalates. Since ADR-003, :providers carries no
      privilege module at all, so nothing should merge WRITE_SECURE_SETTINGS in here — this
      strip is belt-and-braces and the CI gate still fails the build if the merged manifest
      ever regresses. The actual Tier-1 surface (:adb-bridge) links only into portage-recv.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Portage">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
