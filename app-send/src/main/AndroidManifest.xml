<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exporter requests READ-only access to the Tier-0 domains. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- App-inventory enumeration. Confirm GOS policy at runtime (VERIFY_FIRST). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
      Paired-Bluetooth roster read (PRP-07 public-API approach). BLUETOOTH_CONNECT is a NORMAL
      runtime permission (dangerous class), NOT a privilege escalation: it gates the PUBLIC
      BluetoothAdapter.getBondedDevices() API only. It is deliberately distinct from the
      privileged surface the CI no-escalation gate forbids in the sender, and merges into this
      binary alone. (Do NOT name that gate's trigger strings here: the gate greps the MERGED
      manifest, and AGP preserves XML comments, so a comment mentioning them fails the build.)
      Phase 1 reads the LIST; the receiver shows a re-pair
      checklist. maxSdkVersion is intentionally omitted — BLUETOOTH_CONNECT is the API-31+ runtime
      permission and minSdk is 31. VERIFY_FIRST: getBondedDevices + the grant flow on GOS hardware.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Least-privilege: the sender NEVER escalates. Since ADR-003, :providers carries no
      privilege module at all, so nothing should merge WRITE_SECURE_SETTINGS in here — this
      strip is belt-and-braces and the CI gate still fails the build if the merged manifest
      ever regresses. The actual Tier-1 surface (:adb-bridge) links only into portage-recv.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:node="remove" />

    <!--
      Keep a long transfer alive when the screen sleeps (#85): the data phase runs under a
      short-lived foreground service holding a PARTIAL_WAKE_LOCK + a WifiLock(HIGH_PERF), so
      GrapheneOS Doze / Wi-Fi power-save can't suspend the app and let the peer read an RST mid-frame,
      or throttle throughput to a crawl (hardware-observed: a 505 MB transfer trickled at ~0.8 MB/s
      backgrounded without the WifiLock). FOREGROUND_SERVICE and the dataSync type are NORMAL
      install-time permissions — no privilege, no ADB bridge, so the no-escalation CI gate stays
      untouched. ACCESS_WIFI_STATE (also NORMAL/auto-granted) is what WifiManager.WifiLock.acquire()
      requires — declared here so the lock actually engages on hardware (WAKE_LOCK below covers its
      power semantics). POST_NOTIFICATIONS is denied-by-default on GrapheneOS; the process-priority +
      wakelock benefit holds even when the ongoing notification doesn't render (the permission is
      declared, never runtime-requested — no added prompt).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Portage">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Transfer keep-alive foreground service (#85): hosts the data phase's wakelock + foreground
          importance so a screen-off can't reset the streaming socket mid-frame. Not exported, not
          bound — started/stopped only in-process by ForegroundServiceKeepAlive around the transfer.
        -->
        <service
            android:name=".TransferForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
